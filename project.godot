; Verso de Musas (Godot) — port del juego web.
config_version=5

[application]

config/name="Verso de Musas"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/ui/claudia_icon.png"
config/description="Deckbuilder roguelike de musas mágicas del verso"

[autoload]

Meta="*res://scripts/core/meta.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=2

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/integer_division=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/unsafe_call_argument=0
